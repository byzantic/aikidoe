{
  "name": "aikidoe",
  "version": "0.0.0",
  "description": "Design of Experiments assistant in the browser",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "node tests/run-all.mjs",
    "fixtures": "node tools/regen-fixtures.mjs",
    "fixtures:check": "node tools/regen-fixtures.mjs --out .fixtures-fresh && node tools/check-fixtures.mjs --fresh .fixtures-fresh",
    "ui": "node tools/serve.mjs",
    "test:ui": "node tests/ui/smoke.mjs && node tests/ui/learn.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "doe": "tools/doe.mjs"
  }
}
