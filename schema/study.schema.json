{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://byzantic.github.io/aikidoe/schema/study.schema.json",
  "title": "aikidoe study",
  "description": "An aikidoe study file (*.aikidoe.json), format version 1: factors, responses, constraints, the design and its run order, observations, drop-in sites, the stage history and an optional simulator. Comments and trailing commas are allowed in the file (JSON with comments); this schema describes the JSON value.",
  "$comment": "Rules a JSON Schema cannot express, checked by the library's validateStudy: high > low; factor and response ids all distinct; a log-transformed factor has low > 0 and positive settings; every run's settings give every factor and nothing else, with a categorical value among its levels; run and order numbers are distinct; runs in one whole plot share their hard-to-change settings; observations refer to runs in the design and to non-derived responses; derived.from names a non-derived response; history runs are in the design; constraints are linear in continuous factor ids; mixture components are continuous factors (not log, not hard to change) with low ≥ 0, their lows add up to less than the total and their highs to at least it, and every run's components add up to the total; a count response's values are whole numbers ≥ 0, a binomial response's successes lie between 0 and the trials (the response's or the observation's), a bernoulli response's are 0 or 1, and exposure is only for counts with the log link; a target lies between lower and upper; goal 'target' needs a target and goal 'range' lower and upper.",
  "type": "object",
  "required": [
    "aikidoe",
    "seed",
    "factors"
  ],
  "additionalProperties": false,
  "properties": {
    "aikidoe": {
      "const": 1,
      "description": "study format version"
    },
    "name": {
      "type": "string",
      "description": "a short title"
    },
    "description": {
      "type": "string",
      "description": "what the study is for"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "description": "seed of every random step (randomisation, searches)"
    },
    "factors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/factor"
      },
      "description": "the factors varied (continuous or categorical)"
    },
    "responses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/response"
      },
      "description": "what is measured"
    },
    "covariates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/covariate"
      },
      "description": "covariates: variables that are measured but not set (a starting weight, the room temperature), with their values; models take them as terms by id (issue #82)"
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      },
      "description": "linear constraints on the settings"
    },
    "design": {
      "$ref": "#/$defs/design",
      "description": "the runs, in standard order, with their randomised run order"
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      },
      "description": "results: one per reading (run, response, and wafer / site / repeat when measured that way)"
    },
    "sites": {
      "$ref": "#/$defs/sites",
      "description": "drop-in measurement sites on the wafer"
    },
    "plates": {
      "$ref": "#/$defs/plates",
      "description": "microplate layout: each run in a well, controls on every plate"
    },
    "mixture": {
      "$ref": "#/$defs/mixture",
      "description": "mixture components: factors that are shares of a whole, adding up to the total (issue #62)"
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stage"
      },
      "description": "the stages of a sequential experiment"
    },
    "simulator": {
      "type": "object",
      "required": [
        "adapter"
      ],
      "properties": {
        "adapter": {
          "type": "string",
          "description": "expression, comb-over, module (CLI) or another registered adapter"
        }
      },
      "additionalProperties": true,
      "description": "the simulator that runs the design (computer experiments): { adapter, …its options }"
    },
    "exercise": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": true,
      "description": "an exercise this study answers (made by the exercise generator): its id, topic, difficulty, budget, questions, the sealed truth for self-study, and the student's answers",
      "properties": {
        "id": {
          "type": "string"
        },
        "format": {
          "const": "aikidoe-exercise/1"
        },
        "topic": {
          "type": "string"
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "budget": {
          "type": "integer",
          "minimum": 1
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "sealed": {
          "type": "string"
        },
        "answers": {
          "type": "object",
          "description": "{ active: [factor ids], effects: { id: { estimate, lower, upper } }, ratios: { id: { estimate, lower, upper } } (rate or odds ratios, counts topic), best: settings, prediction: { value }, ec50 and potency: { estimate, lower, upper } (dose topic) }"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "description": "an identifier: letters, digits and _, not starting with a digit"
    },
    "label": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "number"
        }
      ],
      "description": "a non-empty string or a number"
    },
    "factor": {
      "oneOf": [
        {
          "$ref": "#/$defs/continuous"
        },
        {
          "$ref": "#/$defs/categorical"
        }
      ]
    },
    "continuous": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "low",
            "high"
          ]
        },
        {
          "required": [
            "levels"
          ]
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "used in formulas, constraints and run sheets"
        },
        "name": {
          "type": "string",
          "description": "a readable name"
        },
        "units": {
          "type": "string",
          "description": "shown in tables and run sheets"
        },
        "type": {
          "const": "continuous",
          "description": "optional: inferred from levels"
        },
        "low": {
          "type": "number",
          "description": "the low end of the range (coded −1)"
        },
        "high": {
          "type": "number",
          "description": "the high end of the range (coded +1)"
        },
        "levels": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number"
          },
          "description": "the levels a multi-level design uses (sorted)"
        },
        "transform": {
          "enum": [
            "none",
            "log"
          ],
          "description": "log: coded on the log scale (e.g. time, dose)"
        },
        "htc": {
          "type": "boolean",
          "description": "hard to change: split-plot designs"
        },
        "tolerance": {
          "description": "standard deviation of the actual value about its setting (natural units), or a distribution",
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "object",
              "required": [
                "sd"
              ],
              "additionalProperties": false,
              "properties": {
                "sd": {
                  "type": "number",
                  "minimum": 0
                },
                "dist": {
                  "enum": [
                    "normal",
                    "uniform",
                    "truncated"
                  ]
                },
                "at": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          ]
        },
        "noise": {
          "type": "object",
          "required": [
            "sd"
          ],
          "additionalProperties": false,
          "properties": {
            "sd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "mean": {
              "type": "number"
            }
          },
          "description": "a noise factor: varied in the experiment, random in production: { sd, mean? } (natural units)"
        },
        "note": {
          "type": "string",
          "description": "free text"
        }
      }
    },
    "categorical": {
      "type": "object",
      "required": [
        "id",
        "levels"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "type"
          ]
        },
        {
          "properties": {
            "levels": {
              "contains": {
                "type": "string"
              }
            }
          }
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "units": {
          "type": "string"
        },
        "type": {
          "const": "categorical",
          "description": "optional when a level is a string"
        },
        "levels": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/label"
          },
          "description": "two or more distinct levels"
        },
        "htc": {
          "type": "boolean",
          "description": "hard to change: split-plot designs"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "response": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "units": {
          "type": "string"
        },
        "distribution": {
          "enum": [
            "normal",
            "poisson",
            "quasipoisson",
            "negbin",
            "binomial",
            "quasibinomial",
            "bernoulli"
          ],
          "default": "normal",
          "description": "the kind of value and its noise (issue #64): a measurement (normal), a count (poisson; negbin or quasipoisson when overdispersed), successes out of trials (binomial, quasibinomial), or pass/fail (bernoulli, 0 or 1). Anything but normal is fitted by a generalised linear model, one observation per run"
        },
        "link": {
          "enum": [
            "identity",
            "log",
            "sqrt",
            "logit",
            "probit",
            "cloglog"
          ],
          "description": "the scale the model is linear on: log (default), identity or sqrt for counts; logit (default), probit or cloglog for proportions"
        },
        "trials": {
          "type": "integer",
          "minimum": 1,
          "description": "binomial: the number of trials in every run (otherwise each observation gives its own)"
        },
        "goal": {
          "enum": [
            "none",
            "maximize",
            "minimize",
            "target",
            "range"
          ],
          "description": "for optimisation (desirability)"
        },
        "target": {
          "type": "number",
          "description": "desirability target"
        },
        "lower": {
          "type": "number",
          "description": "desirability lower limit"
        },
        "upper": {
          "type": "number",
          "description": "desirability upper limit"
        },
        "weight": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              ],
              "minItems": 2,
              "items": false
            }
          ],
          "description": "desirability shape: one number, or two (below, above a target)"
        },
        "importance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "relative importance in the overall desirability"
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "lot",
              "run",
              "wholePlot",
              "wafer",
              "site"
            ]
          },
          "description": "measurement hierarchy, in nesting order"
        },
        "derived": {
          "type": "object",
          "required": [
            "from",
            "stat"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string"
            },
            "stat": {
              "enum": [
                "mean",
                "sd",
                "logsd",
                "rangemean"
              ]
            }
          },
          "description": "a per-wafer summary of another response, computed from its readings"
        },
        "measurement": {
          "type": "object",
          "required": [
            "sigma"
          ],
          "additionalProperties": false,
          "properties": {
            "sigma": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "method": {},
            "design": {},
            "parts": {},
            "operators": {},
            "repeats": {},
            "tolerance": {},
            "pctGRR": {},
            "ndc": {},
            "date": {},
            "data": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "part",
                  "value"
                ],
                "properties": {
                  "part": {
                    "$ref": "#/$defs/label"
                  },
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            },
            "note": {}
          },
          "description": "the measurement system, from a gauge R&R study: { sigma, … }"
        },
        "spec": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "lower": {
              "type": "number"
            },
            "upper": {
              "type": "number"
            }
          },
          "description": "specification limits for yield"
        },
        "note": {
          "type": "string",
          "description": "free text"
        }
      }
    },
    "constraint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "expr"
          ],
          "additionalProperties": false,
          "properties": {
            "expr": {
              "type": "string"
            },
            "units": {
              "enum": [
                "natural",
                "coded"
              ]
            }
          }
        }
      ],
      "description": "a linear constraint, e.g. \"T + 2*t <= 1050\""
    },
    "design": {
      "type": "object",
      "required": [
        "runs"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "description": "the kind of design (fractional-factorial, ccd, split-plot-fraction, sequential, …)"
        },
        "params": {
          "type": "object",
          "description": "the design's parameters (generators, resolution, α, …)"
        },
        "randomisation": {
          "enum": [
            "complete",
            "restricted",
            "blocked",
            "none"
          ],
          "description": "complete; restricted (split-plot); blocked; or none"
        },
        "blocking": {
          "type": "array",
          "description": "named blocking variables, when the runs are grouped two or more ways (a Latin square's rows and columns, a crossover's subjects and periods); each run gives its label for each in blocks",
          "items": {
            "$ref": "#/$defs/blocking"
          }
        },
        "carryover": {
          "type": "boolean",
          "description": "a crossover design: the analysis adds a carry-over term (the treatment each subject had in the period before)"
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
          }
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "run",
        "settings"
      ],
      "additionalProperties": false,
      "properties": {
        "run": {
          "type": "integer",
          "minimum": 1,
          "description": "run number (standard order)"
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "description": "the randomised order in which to run it"
        },
        "wholePlot": {
          "$ref": "#/$defs/label",
          "description": "whole plot (split-plot designs)"
        },
        "block": {
          "$ref": "#/$defs/label",
          "description": "block (stage, day, batch)"
        },
        "blocks": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/label"
          },
          "description": "the run's label for each of design.blocking"
        },
        "kind": {
          "enum": [
            "factorial",
            "fraction",
            "axial",
            "centre",
            "confirm",
            "augment",
            "optimal",
            "space-filling",
            "other"
          ],
          "description": "the part of the design it comes from"
        },
        "settings": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          },
          "description": "factor id → setting (natural units, or a level)"
        }
      }
    },
    "observation": {
      "type": "object",
      "required": [
        "run",
        "response",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "run": {
          "type": "integer",
          "description": "the run"
        },
        "response": {
          "type": "string",
          "description": "the response id"
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "description": "null: missing (measured but failed)"
        },
        "trials": {
          "type": "integer",
          "minimum": 1,
          "description": "binomial response: the trials of this run (value is the number of successes)"
        },
        "exposure": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "count response with the log link: what the count is out of (volume plated, area, cells examined); its log is an offset, so the model is for the rate (default 1)"
        },
        "lot": {
          "$ref": "#/$defs/label",
          "description": "lot"
        },
        "wafer": {
          "$ref": "#/$defs/label",
          "description": "wafer within the run"
        },
        "site": {
          "$ref": "#/$defs/label",
          "description": "site on the wafer"
        },
        "slot": {
          "$ref": "#/$defs/label",
          "description": "boat slot"
        },
        "operator": {
          "$ref": "#/$defs/label",
          "description": "operator"
        },
        "repeat": {
          "type": "integer",
          "description": "repeat reading"
        },
        "note": {
          "type": "string",
          "description": "free text"
        }
      }
    },
    "sites": {
      "type": "object",
      "required": [
        "positions"
      ],
      "additionalProperties": false,
      "properties": {
        "scheme": {
          "type": "string",
          "description": "5-site, 9-site, dropin-9 or custom"
        },
        "diameter": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "wafer diameter, mm"
        },
        "positions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "x",
              "y"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/label"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          },
          "description": "site id and x, y in mm from the wafer centre"
        }
      }
    },
    "stage": {
      "type": "object",
      "required": [
        "stage"
      ],
      "additionalProperties": false,
      "properties": {
        "stage": {
          "type": "string",
          "minLength": 1,
          "description": "name: screen, foldover, axial, augment, confirm, …"
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "the runs added in this stage"
        },
        "date": {
          "type": "string",
          "description": "when"
        },
        "note": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "description": "the stage's parameters"
        }
      }
    },
    "plates": {
      "type": "object",
      "required": [
        "rows",
        "cols"
      ],
      "additionalProperties": false,
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "description": "rows of wells (8 for a 96-well plate)"
        },
        "cols": {
          "type": "integer",
          "minimum": 1,
          "maximum": 48,
          "description": "columns of wells (12 for a 96-well plate)"
        },
        "exclude": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "const": "edge"
              },
              {
                "type": "string",
                "pattern": "^[A-Za-z]{1,2}0*[1-9][0-9]*$",
                "description": "well id: row letter(s) and column, e.g. B07"
              }
            ]
          },
          "description": "wells left empty: \"edge\" (the outer ring) or well ids"
        },
        "controls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "perPlate"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "name": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "positive",
                  "negative",
                  "blank",
                  "standard",
                  "other"
                ],
                "description": "positive and negative controls give Z′"
              },
              "perPlate": {
                "type": "integer",
                "minimum": 1,
                "description": "wells per plate"
              }
            }
          },
          "description": "control wells on every plate"
        },
        "layout": {
          "enum": [
            "balanced",
            "random",
            "ordered"
          ],
          "description": "how the runs were placed (default balanced)"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "efficiency": {
          "type": "number",
          "description": "layout efficiency for the design's model (1 = position costs nothing)"
        },
        "wells": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "plate",
              "well"
            ],
            "additionalProperties": false,
            "properties": {
              "plate": {
                "type": "integer",
                "minimum": 1
              },
              "well": {
                "type": "string",
                "pattern": "^[A-Za-z]{1,2}0*[1-9][0-9]*$",
                "description": "well id: row letter(s) and column, e.g. B07"
              },
              "run": {
                "type": "integer",
                "minimum": 1
              },
              "control": {
                "$ref": "#/$defs/id"
              }
            },
            "oneOf": [
              {
                "required": [
                  "run"
                ]
              },
              {
                "required": [
                  "control"
                ]
              }
            ]
          },
          "description": "each used well: a run of the design or a control"
        },
        "readings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "plate",
              "well",
              "response",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "plate": {
                "type": "integer",
                "minimum": 1
              },
              "well": {
                "type": "string",
                "pattern": "^[A-Za-z]{1,2}0*[1-9][0-9]*$",
                "description": "well id: row letter(s) and column, e.g. B07"
              },
              "response": {
                "$ref": "#/$defs/id"
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "description": "results of the control wells"
        }
      }
    },
    "mixture": {
      "type": "object",
      "required": [
        "components"
      ],
      "additionalProperties": false,
      "properties": {
        "components": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          },
          "description": "ids of continuous factors (not log, not hard to change, low ≥ 0) that are components of the mixture"
        },
        "total": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1,
          "description": "what the components add up to in every run (1, 100 %, or the batch size)"
        }
      }
    },
    "covariate": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "used in formulas; differs from every factor and response id"
        },
        "name": {
          "type": "string",
          "description": "display name (default: the id)"
        },
        "units": {
          "type": "string"
        },
        "note": {
          "type": "string",
          "description": "free text"
        },
        "values": {
          "type": "array",
          "description": "the values measured: one per run, or one per wafer (lot, site) of a run when it was measured there. A run with no value is left out of a model that has the covariate",
          "items": {
            "type": "object",
            "required": [
              "run",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "run": {
                "type": "integer",
                "description": "the run"
              },
              "value": {
                "type": "number",
                "description": "the value measured"
              },
              "lot": {
                "$ref": "#/$defs/label",
                "description": "lot, when the value belongs to one lot of the run"
              },
              "wafer": {
                "$ref": "#/$defs/label",
                "description": "wafer, when the value belongs to one wafer of the run"
              },
              "site": {
                "$ref": "#/$defs/label",
                "description": "site, when the value belongs to one site"
              },
              "unit": {
                "$ref": "#/$defs/label",
                "description": "the unit (animal, flask, wafer) the run was given, when units were allocated to runs by this covariate (doe allocate)"
              }
            }
          }
        }
      }
    },
    "blocking": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "used in run sheets and for --random"
        },
        "name": {
          "type": "string",
          "description": "a readable name (Day, Operator)"
        },
        "role": {
          "enum": [
            "row",
            "column",
            "subject",
            "period"
          ],
          "description": "rows and columns of a Latin square; subjects and periods of a crossover"
        },
        "levels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/label"
          },
          "description": "the labels in order (a crossover's periods in time order)"
        }
      }
    }
  }
}
